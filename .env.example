# ===================================================================
# Student Performance Analyzer - Backend Environment Variables
# ===================================================================
# Set these on your hosting platform (Render, Railway, Heroku, Docker)
# or when connecting to cloud MySQL (Aiven, Railway, AWS RDS, PlanetScale):

# Database Connection (Production with SSL/TLS)
# Aiven / Railway Cloud MySQL Example:
# DB_URL=jdbc:mysql://mysql-xxxx.aivencloud.com:15432/defaultdb?sslmode=require&allowPublicKeyRetrieval=true
# Local Development (Default):
DB_URL=jdbc:mysql://localhost:3306/factory_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=root

# Server Port (Render / Railway binds PORT dynamically)
PORT=8080

# JWT Security Key (Must be at least 256 bits long)
JWT_SECRET=MyStudentPerformanceAnalyzerSecretKey2026AtLeast256BitsLong!
JWT_EXPIRATION=36000000

# Hibernate Schema Auto Mode ('update' ensures tables auto-create on first boot)
HIBERNATE_DDL_AUTO=update
